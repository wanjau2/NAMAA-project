# Namaa Docker Compose — synthetic demo only
NAMAA_API_PORT=8000
NAMAA_WEB_PORT=3000

# Browser API origin. Compiled into the web bundle at `next build` /
# `docker compose build`. Changing this after the image exists has no effect
# until you rebuild the web service. Must be a URL the *browser* can reach.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Deprecated alias — Compose still uses this if NEXT_PUBLIC_API_BASE_URL is unset.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Exact browser origins (scheme + host + port) allowed to call the API.
# Defaults cover `npm start` / Compose on :3000. Playwright on :3200 sets this itself.
NAMAA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NAMAA_DEMO_NOW=2026-11-17T09:00:00Z
NAMAA_SMALL_CELL_THRESHOLD=10
