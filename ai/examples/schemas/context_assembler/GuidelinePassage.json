{
  "$defs": {
    "ResourceVersion": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "pattern": "^[A-Z][A-Za-z]+/[A-Za-z0-9.-]{1,64}$",
          "title": "Reference",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "version"
      ],
      "title": "ResourceVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/ResourceVersion"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "maxLength": 6000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Text",
      "type": "string"
    },
    "offset_start": {
      "minimum": 0,
      "title": "Offset Start",
      "type": "integer"
    },
    "offset_end": {
      "minimum": 1,
      "title": "Offset End",
      "type": "integer"
    },
    "approved": {
      "title": "Approved",
      "type": "boolean"
    },
    "approved_by": {
      "pattern": "^Practitioner(Role)?/[A-Za-z0-9.-]{1,64}$",
      "title": "Approved By",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    }
  },
  "required": [
    "source",
    "title",
    "text",
    "offset_start",
    "offset_end",
    "approved",
    "approved_by",
    "approved_at"
  ],
  "title": "GuidelinePassage",
  "type": "object"
}
