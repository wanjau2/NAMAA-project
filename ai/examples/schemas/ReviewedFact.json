{
  "$defs": {
    "ExtractionProposal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "state": {
          "const": "proposed",
          "default": "proposed",
          "title": "State",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Workspace Id",
          "type": "string"
        },
        "patient_reference": {
          "pattern": "^Patient/[A-Za-z0-9.-]{1,64}$",
          "title": "Patient Reference",
          "type": "string"
        },
        "source_document_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Source Document Id",
          "type": "string"
        },
        "source_document_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Source Document Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "fact": {
          "$ref": "#/$defs/ProposedFact"
        },
        "offset_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset Start"
        },
        "offset_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset End"
        },
        "offset_unit": {
          "const": "unicode_code_points",
          "default": "unicode_code_points",
          "title": "Offset Unit",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "patient_reference",
        "source_document_id",
        "source_document_version",
        "source_sha256",
        "fact",
        "offset_start",
        "offset_end",
        "issues",
        "model"
      ],
      "title": "ExtractionProposal",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "const": "google/medgemma-1.5-4b-it",
          "default": "google/medgemma-1.5-4b-it",
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 6000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Revision",
          "type": "string"
        },
        "prompt_version": {
          "const": "extract-v1.0.0",
          "default": "extract-v1.0.0",
          "title": "Prompt Version",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "model_revision",
        "simulated"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "ProposedFact": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "enum": [
            "last_wcv",
            "last_adult_screening",
            "caregiver_concern",
            "tobacco_use",
            "family_condition"
          ],
          "title": "Concept",
          "type": "string"
        },
        "value_text": {
          "maxLength": 6000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value Text",
          "type": "string"
        },
        "subject": {
          "enum": [
            "patient",
            "family_member"
          ],
          "title": "Subject",
          "type": "string"
        },
        "assertion": {
          "enum": [
            "present",
            "absent",
            "uncertain",
            "historical"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Date"
        },
        "excerpt": {
          "maxLength": 6000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Excerpt",
          "type": "string"
        },
        "proposed_resource_type": {
          "enum": [
            "Observation",
            "FamilyMemberHistory"
          ],
          "title": "Proposed Resource Type",
          "type": "string"
        },
        "relationship": {
          "anyOf": [
            {
              "enum": [
                "mother",
                "father",
                "sister",
                "brother",
                "sibling",
                "grandmother",
                "grandfather"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relationship"
        }
      },
      "required": [
        "concept",
        "value_text",
        "subject",
        "assertion",
        "effective_date",
        "excerpt",
        "proposed_resource_type",
        "relationship"
      ],
      "title": "ProposedFact",
      "type": "object"
    },
    "ReviewCommand": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "proposal_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+$",
          "title": "Proposal Id",
          "type": "string"
        },
        "expected_proposal_version": {
          "minimum": 1,
          "title": "Expected Proposal Version",
          "type": "integer"
        },
        "action": {
          "enum": [
            "accept",
            "correct",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "reviewer_reference": {
          "pattern": "^Practitioner(Role)?/[A-Za-z0-9.-]{1,64}$",
          "title": "Reviewer Reference",
          "type": "string"
        },
        "reason": {
          "maxLength": 6000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedFact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acknowledged_issues": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Acknowledged Issues",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "proposal_id",
        "expected_proposal_version",
        "action",
        "reviewer_reference",
        "reason"
      ],
      "title": "ReviewCommand",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "block",
            "review"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proposal": {
      "$ref": "#/$defs/ExtractionProposal"
    },
    "fact": {
      "$ref": "#/$defs/ProposedFact"
    },
    "review": {
      "$ref": "#/$defs/ReviewCommand"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "source_date": {
      "format": "date",
      "title": "Source Date",
      "type": "string"
    },
    "offset_start": {
      "minimum": 0,
      "title": "Offset Start",
      "type": "integer"
    },
    "offset_end": {
      "minimum": 1,
      "title": "Offset End",
      "type": "integer"
    }
  },
  "required": [
    "proposal",
    "fact",
    "review",
    "reviewed_at",
    "source_date",
    "offset_start",
    "offset_end"
  ],
  "title": "ReviewedFact",
  "type": "object"
}
