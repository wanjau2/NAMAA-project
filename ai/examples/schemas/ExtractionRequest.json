{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$",
      "title": "Workspace Id",
      "type": "string"
    },
    "patient_reference": {
      "pattern": "^Patient/[A-Za-z0-9.-]{1,64}$",
      "title": "Patient Reference",
      "type": "string"
    },
    "source_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+$",
      "title": "Source Version",
      "type": "string"
    },
    "source_date": {
      "format": "date",
      "title": "Source Date",
      "type": "string"
    },
    "language": {
      "const": "en",
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "note_text": {
      "maxLength": 6000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Note Text",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "workspace_id",
    "patient_reference",
    "source_id",
    "source_version",
    "source_date",
    "note_text"
  ],
  "title": "ExtractionRequest",
  "type": "object"
}
