# Backend worker only. Copy/export deliberately; the package does not load .env.
NAMAA_HF_ENDPOINT_URL=
NAMAA_HF_TOKEN=
# Set to the actual immutable model commit deployed by Ismail; never 'main'.
NAMAA_MODEL_REVISION=
NAMAA_ENDPOINT_PROTOCOL=namaa-extraction-v1
# Prompt is bundled and pinned in code: extract-v1.0.1
# Relate remains disabled; no environment switch bypasses backend verification.
# Session/role/service-token headers are supplied by the backend caller.
NAMAA_API_BASE_URL=
# Opt-in live tests create their own synthetic guest sessions.
NAMAA_AI_TEST_API_URL=
NAMAA_AI_TEST_SERVICE_TOKEN=
# Optional synthetic reviewer binding; default Practitioner/demo-reviewer.
NAMAA_AI_TEST_REVIEWER=
# JSON mapping of all four canonical outcomes to backend seed patient/pathway.
NAMAA_AI_TEST_RULE_CASES=
