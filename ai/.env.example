# Backend worker only. Copy/export deliberately; the package does not load .env.
NAMAA_HF_ENDPOINT_URL=
NAMAA_HF_TOKEN=
# Set to the actual immutable model commit deployed by Ismail; never 'main'.
NAMAA_MODEL_REVISION=
NAMAA_ENDPOINT_PROTOCOL=namaa-extraction-v1
# Prompt is bundled and pinned in code: extract-v1.0.0
# Relate remains disabled; no environment switch bypasses backend verification.
